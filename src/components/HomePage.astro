---
//
//  HomePage.astro
//  CV Hub
//
//  Created by Alexander Gusarov on 03.03.2026.
//  @spartan121
//
import Layout from './Layout.astro';
import { getEntry } from 'astro:content';
import { makeT } from '../scripts/t';

const base = String(import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (p = '') => {
  if (!p) return '';
  if (/^https?:\/\//.test(p) || p.startsWith('data:')) return p;
  return `${base}${p.startsWith('/') ? p : `/${p}`}`;
};

const {
  lang = 'en',
  data = {},
  downloadUrls = {},
  t: tProp = {},
  profile = ""
} = Astro.props;

const t = {
  nameFallback:     tProp.nameFallback     ?? 'Unnamed',
  contacts:         tProp.contacts         ?? 'Contacts',
  skills:           tProp.skills           ?? 'Skills',
  experience:       tProp.experience       ?? 'Experience',
  achievements:     tProp.achievements     ?? 'Achievements',
  downloads:        tProp.downloads        ?? 'Download',
  company:          tProp.company          ?? 'Company',
  salary:           tProp.salary           ?? 'Expected salary',
  employment:       tProp.employment       ?? 'Employment',
  work_format:      tProp.work_format      ?? 'Work format',
  location_label:   tProp.location_label   ?? 'Location',
  work_permit:      tProp.work_permit      ?? 'Work permit',
  education:        tProp.education        ?? 'Education',
  languages_known:  tProp.languages_known  ?? 'Languages',
  about_me:         tProp.about_me         ?? 'About me',
  empty_skills:     tProp.empty_skills     ?? 'Add skills to YAML — tags will appear here.',
  empty_experience: tProp.empty_experience ?? 'Add experience to YAML — your timeline will appear here.',
};

let siteConfig = null;
try { siteConfig = await getEntry('site', 'site'); } catch {}
const rawDownloads = siteConfig?.data?.downloads ?? ['pdf', 'docx'];

const downloadGroups = rawDownloads.length === 0
  ? []
  : typeof rawDownloads[0] === 'string'
    ? [{ group: null, items: rawDownloads }]
    : rawDownloads.map((g) => ({ group: g.group ?? null, items: g.items ?? [] }));

let translations = null;
try { translations = await getEntry('i18n', 'translations'); } catch {}
const t2 = makeT(translations?.data ?? {}, lang);
const groupLabel = (group) => {
  if (!group) return null;
  const key = `cv.downloads_${group}`;
  const resolved = t2(key);
  return resolved === key ? group : resolved;
};

const downloadMeta = {
  pdf:    { label: 'PDF',  ariaLabel: 'Resume PDF',        solid: true },
  pdfAts: { label: 'PDF',  ariaLabel: 'ATS-optimized PDF', solid: false, hint: 'ATS-optimized, single-column version — for pasting into a job-portal upload form' },
  docx:   { label: 'DOCX', ariaLabel: 'Resume DOCX',       solid: false },
  txt:    { label: 'TXT',  ariaLabel: 'Resume plain text', solid: false },
};

const downloads = downloadGroups
  .map((g) => ({
    label: groupLabel(g.group),
    items: g.items
      .map((key) => ({ key, url: downloadUrls[key], ...downloadMeta[key] }))
      .filter((d) => d.url && d.label),
  }))
  .filter((g) => g.items.length > 0);

const pageTitle = `${data?.name ?? t.nameFallback} — CV Hub`;

const contacts     = Array.isArray(data?.contacts)    ? data.contacts    : [];
const rawSkills    = Array.isArray(data?.skills)      ? data.skills      : [];
const experience   = Array.isArray(data?.experience)  ? data.experience  : [];
const achievements = Array.isArray(data?.achievements)? data.achievements: [];
const education    = Array.isArray(data?.education)   ? data.education   : [];
const languages    = Array.isArray(data?.languages)   ? data.languages   : [];

const avatarUrl = data?.image ? withBase(data.image) : null;

const normalizeBullet = (v) => {
  if (typeof v === 'string') return v;
  if (v && typeof v === 'object') {
    if (typeof v.text === 'string') return v.text;
    if (typeof v.label === 'string' && typeof v.value === 'string') return `${v.label}: ${v.value}`;
    return Object.entries(v).map(([k, val]) => `${k}: ${String(val)}`).join(' · ');
  }
  return String(v);
};

const skillGroups = rawSkills
  .map((s) =>
    typeof s === 'string'
      ? { group: null, items: [s] }
      : { group: s?.group ?? null, items: Array.isArray(s?.items) ? s.items : [] }
  )
  .filter((g) => g.items.length > 0);

const emailContact = contacts.find((c) => /^mailto:/i.test(c?.url ?? ''));
const profileContacts = contacts.filter((c) => /^https?:\/\//i.test(c?.url ?? ''));
const personJsonLd = data?.name ? {
  name: data.name,
  jobTitle: data?.title || undefined,
  description: data?.summary || undefined,
  email: emailContact ? emailContact.url.replace(/^mailto:/i, '') : undefined,
  sameAs: profileContacts.map((c) => c.url),
  knowsAbout: skillGroups.flatMap((g) => g.items),
} : undefined;
---

<Layout title={pageTitle} description={data?.summary || undefined} personJsonLd={personJsonLd} lang={lang} section="main" profile={profile}>
  <section class="container">
    <div class="page-grid">

      {/* ── SIDEBAR ── */}
      <aside class="sidebar">

        {/* 1. Download */}
        <article class="card card--downloads">
          <h2 class="h2">{t.downloads}</h2>
          {downloads.map((g) => (
            <Fragment>
              {g.label && <div class="skillsgroup__title">{g.label}</div>}
              <div class="btnrow" aria-label={g.label ?? t.downloads}>
                {g.items.map((d) => (
                  <a class={`btn ${d.solid ? '' : 'btn--ghost'}`} href={d.url} download aria-label={d.ariaLabel} title={d.hint}>{d.label}</a>
                ))}
              </div>
            </Fragment>
          ))}
        </article>

        {/* 2. Avatar */}
        {avatarUrl && (
          <article class="card card--avatar">
            <img class="avatar__img" src={avatarUrl} alt={data?.name ?? t.nameFallback} width="640" height="240" loading="lazy" decoding="async" />
          </article>
        )}

        {/* 3. Skills */}
        <article class="card card--skills">
          <h2 class="h2">{t.skills}</h2>
          {skillGroups.length > 0 ? (
            <div class="skillsgrid">
              {skillGroups.map((g) => (
                <div class="skillsgroup">
                  {g.group && <div class="skillsgroup__title">{g.group}</div>}
                  <ul class="tags">
                    {g.items.map((s) => <li class="tag">{s}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          ) : (
            <p class="muted">
              {t.empty_skills}
            </p>
          )}
        </article>

        {/* 4. Languages */}
        {languages.length > 0 && (
          <article class="card card--languages">
            <h2 class="h2">{t.languages_known}</h2>
            <ul class="lang-list">
              {languages.map((l) => (
                <li class="lang-item">
                  <span class="lang-item__name">{l.language}</span>
                  {l.level && <span class="muted lang-item__level"> — {l.level}</span>}
                </li>
              ))}
            </ul>
          </article>
        )}

      </aside>

      {/* ── MAIN CONTENT ── */}
      <main class="main-content">

        {/* 1. Hero */}
        <div class="card hero">
          <div class="hero__top">
            <div>
              <h1 class="hero__name">{data?.name ?? t.nameFallback}</h1>
              {/* Gender / birthdate line — hh.ru style */}
              {(data?.gender || data?.birthdate) && (
                <p class="hero__meta-line">
                  {[data.gender, data.birthdate].filter(Boolean).join(', ')}
                </p>
              )}
              {data?.title && <p class="hero__title">{data.title}</p>}
            </div>
          </div>

          {/* Location & work preferences */}
          {(data?.location || data?.work_permit || data?.employment || data?.work_format) && (
            <div class="hero__info">
              {data?.location && (
                <div class="hero__info-row">
                  <span class="hero__info-label">{t.location_label}:</span>
                  <span>{data.location}</span>
                </div>
              )}
              {data?.work_permit && (
                <div class="hero__info-row">
                  <span class="hero__info-label">{t.work_permit}:</span>
                  <span>{data.work_permit}</span>
                </div>
              )}
              {data?.employment && (
                <div class="hero__info-row">
                  <span class="hero__info-label">{t.employment}:</span>
                  <span>{data.employment}</span>
                </div>
              )}
              {data?.work_format && (
                <div class="hero__info-row">
                  <span class="hero__info-label">{t.work_format}:</span>
                  <span>{data.work_format}</span>
                </div>
              )}
            </div>
          )}

          {/* Salary block — hh.ru style highlighted */}
          {data?.salary && (
            <div class="hero__salary">
              <div class="hero__salary-label">{t.salary}</div>
              <div class="hero__salary-value">{data.salary}</div>
            </div>
          )}

          {/* Summary / About me */}
          {data?.summary && (
            <div class="hero__about">
              <div class="section__title">{t.about_me}</div>
              <p class="hero__summary">{data.summary}</p>
            </div>
          )}

          {contacts.length > 0 && (
            <div class="hero__contacts">
              <div class="section__title">{t.contacts}</div>
              <div class="pillrow">
                {contacts.map((c) => (
                  <a
                    class="pill"
                    href={c.url}
                    target={c.url?.startsWith('mailto:') || c.url?.startsWith('tel:') ? undefined : '_blank'}
                    rel={c.url?.startsWith('mailto:') || c.url?.startsWith('tel:')    ? undefined : 'noopener'}
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* 2. Achievements */}
        {achievements.length > 0 && (
          <article class="card card--achievements">
            <h2 class="h2">{t.achievements}</h2>
            <ul class="list">
              {achievements.map((a) => <li>{a}</li>)}
            </ul>
          </article>
        )}

        {/* 3. Experience */}
        <section class="section section--experience">
          <h2 class="h2">{t.experience}</h2>

          {experience.length > 0 ? (
            <div class="stack">
              {experience.map((e) => (
                <article class="card item">
                  <div class="item__top">
                    <strong>{e.company ?? t.company}</strong>
                    <span class="muted">{e.period ?? ''}</span>
                  </div>
                  {e.role && <div class="item__role">{e.role}</div>}
                  {Array.isArray(e.description) && e.description.length > 0 && (
                    <ul class="list">
                      {e.description.map((d) => <li>{normalizeBullet(d)}</li>)}
                    </ul>
                  )}
                  {Array.isArray(e.stack) && e.stack.length > 0 && (
                    <div class="item__stack">
                      <ul class="tags">
                        {e.stack.map((s) => <li class="tag">{s}</li>)}
                      </ul>
                    </div>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <article class="card">
              <p class="muted">
                {t.empty_experience}
              </p>
            </article>
          )}
        </section>

        {/* 4. Education */}
        {education.length > 0 && (
          <section class="section section--education">
            <h2 class="h2">{t.education}</h2>
            <div class="stack">
              {education.map((e) => (
                <article class="card item">
                  <div class="item__top">
                    <strong>{e.institution}</strong>
                    <span class="muted">{e.period ?? ''}</span>
                  </div>
                  {e.degree && <div class="item__role muted">{e.degree}</div>}
                </article>
              ))}
            </div>
          </section>
        )}

      </main>
    </div>
  </section>
</Layout>
